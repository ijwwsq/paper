// paper — soft paper for VS Code.
// Merge into your settings.json (Ctrl+Shift+P → "Preferences: Open User Settings (JSON)").
{
    "workbench.colorTheme": "Light Modern",
    "editor.fontFamily": "'JetBrains Mono', Consolas, monospace",
    "terminal.integrated.fontFamily": "'JetBrains Mono'",
    "terminal.integrated.fontSize": 13,
    "terminal.integrated.cursorStyle": "block",
    "editor.cursorBlinking": "solid",
    "editor.renderLineHighlight": "line",
    "workbench.colorCustomizations": {
        "[Light Modern]": {
            "editor.background": "#fcfcfa",
            "editor.foreground": "#2f2f2f",
            "editor.lineHighlightBackground": "#f4f4f1",
            "editor.lineHighlightBorder": "#00000000",
            "editor.selectionBackground": "#e1e7f0",
            "editor.findMatchHighlightBackground": "#f2e6c4",
            "editorCursor.foreground": "#6b6b6b",
            "editorLineNumber.foreground": "#c4c4bf",
            "editorLineNumber.activeForeground": "#6b6b67",
            "editorIndentGuide.background1": "#efefeb",
            "editorWhitespace.foreground": "#dcdcd8",
            "editorGroupHeader.tabsBackground": "#f6f6f3",
            "editorGroup.border": "#e4e4e0",
            "tab.activeBackground": "#fcfcfa",
            "tab.inactiveBackground": "#f6f6f3",
            "tab.activeBorderTop": "#5b6fa8",
            "tab.border": "#e4e4e0",
            "sideBar.background": "#f6f6f3",
            "sideBar.border": "#e4e4e0",
            "sideBarSectionHeader.background": "#f6f6f3",
            "activityBar.background": "#f6f6f3",
            "activityBar.foreground": "#2f2f2f",
            "activityBar.inactiveForeground": "#a1a19c",
            "activityBar.border": "#e4e4e0",
            "activityBarBadge.background": "#5b6fa8",
            "titleBar.activeBackground": "#f6f6f3",
            "titleBar.inactiveBackground": "#f6f6f3",
            "titleBar.border": "#e4e4e0",
            "statusBar.background": "#f6f6f3",
            "statusBar.foreground": "#6b6b67",
            "statusBar.border": "#e4e4e0",
            "statusBar.noFolderBackground": "#f6f6f3",
            "statusBar.debuggingBackground": "#5b6fa8",
            "panel.background": "#fcfcfa",
            "panel.border": "#e4e4e0",
            "focusBorder": "#5b6fa8",
            "button.background": "#5b6fa8",
            "list.activeSelectionBackground": "#e1e7f0",
            "list.inactiveSelectionBackground": "#ececE8",
            "list.hoverBackground": "#efefeb",
            "terminal.background": "#fcfcfa",
            "terminal.foreground": "#2f2f2f",
            "terminalCursor.foreground": "#6b6b6b",
            "terminal.selectionBackground": "#e1e7f0",
            "terminal.ansiBlack": "#3a3a3a",
            "terminal.ansiRed": "#b5584e",
            "terminal.ansiGreen": "#5e8a5c",
            "terminal.ansiYellow": "#a5803a",
            "terminal.ansiBlue": "#5b6fa8",
            "terminal.ansiMagenta": "#8d6597",
            "terminal.ansiCyan": "#4d8a8c",
            "terminal.ansiWhite": "#a9a9a6",
            "terminal.ansiBrightBlack": "#8c8c88",
            "terminal.ansiBrightRed": "#c46f66",
            "terminal.ansiBrightGreen": "#729c6f",
            "terminal.ansiBrightYellow": "#b8934c",
            "terminal.ansiBrightBlue": "#7083b8",
            "terminal.ansiBrightMagenta": "#9f79a8",
            "terminal.ansiBrightCyan": "#629b9d",
            "terminal.ansiBrightWhite": "#cfcfcb"
        }
    }
}
