// paper — charcoal paper for VS Code.
// Merge into your settings.json (Ctrl+Shift+P → "Preferences: Open User Settings (JSON)").
{
    "workbench.colorTheme": "Dark Modern",
    "editor.fontFamily": "'JetBrains Mono', Consolas, monospace",
    "terminal.integrated.fontFamily": "'JetBrains Mono'",
    "terminal.integrated.fontSize": 13,
    "terminal.integrated.cursorStyle": "block",
    "editor.cursorBlinking": "solid",
    "editor.renderLineHighlight": "line",
    "workbench.colorCustomizations": {
        "[Dark Modern]": {
            "editor.background": "#1c1c1a",
            "editor.foreground": "#d6d6d0",
            "editor.lineHighlightBackground": "#222220",
            "editor.lineHighlightBorder": "#00000000",
            "editor.selectionBackground": "#2e3546",
            "editor.findMatchHighlightBackground": "#4a3f22",
            "editorCursor.foreground": "#b8b8b2",
            "editorLineNumber.foreground": "#4a4a46",
            "editorLineNumber.activeForeground": "#8c8c88",
            "editorIndentGuide.background1": "#262624",
            "editorWhitespace.foreground": "#33332f",
            "editorGroupHeader.tabsBackground": "#181816",
            "editorGroup.border": "#2a2a27",
            "tab.activeBackground": "#1c1c1a",
            "tab.inactiveBackground": "#181816",
            "tab.activeBorderTop": "#7c8fc4",
            "tab.activeBorder": "#1c1c1a",
            "tab.border": "#2a2a27",
            "sideBar.background": "#181816",
            "sideBar.border": "#2a2a27",
            "sideBarSectionHeader.background": "#181816",
            "activityBar.background": "#181816",
            "activityBar.foreground": "#d6d6d0",
            "activityBar.inactiveForeground": "#5a5a56",
            "activityBar.border": "#2a2a27",
            "activityBar.activeBorder": "#7c8fc4",
            "activityBarBadge.background": "#5b6fa8",
            "titleBar.activeBackground": "#181816",
            "titleBar.inactiveBackground": "#181816",
            "titleBar.border": "#2a2a27",
            "statusBar.background": "#181816",
            "statusBar.foreground": "#8c8c88",
            "statusBar.border": "#2a2a27",
            "statusBar.noFolderBackground": "#181816",
            "statusBar.debuggingBackground": "#5b6fa8",
            "statusBarItem.remoteBackground": "#181816",
            "statusBarItem.remoteForeground": "#8c8c88",
            "panel.background": "#1c1c1a",
            "panel.border": "#2a2a27",
            "focusBorder": "#5b6fa8",
            "button.background": "#5b6fa8",
            "list.activeSelectionBackground": "#2e3546",
            "list.inactiveSelectionBackground": "#262624",
            "list.hoverBackground": "#222220",
            "input.background": "#222220",
            "dropdown.background": "#222220",
            "terminal.background": "#1c1c1a",
            "terminal.foreground": "#d6d6d0",
            "terminalCursor.foreground": "#b8b8b2",
            "terminal.selectionBackground": "#2e3546",
            "terminal.ansiBlack": "#3a3a37",
            "terminal.ansiRed": "#c46f66",
            "terminal.ansiGreen": "#7fa37c",
            "terminal.ansiYellow": "#c4a15c",
            "terminal.ansiBlue": "#7c8fc4",
            "terminal.ansiMagenta": "#a886b0",
            "terminal.ansiCyan": "#6fa5a7",
            "terminal.ansiWhite": "#c8c8c2",
            "terminal.ansiBrightBlack": "#6b6b67",
            "terminal.ansiBrightRed": "#d48479",
            "terminal.ansiBrightGreen": "#92b58f",
            "terminal.ansiBrightYellow": "#d4b46e",
            "terminal.ansiBrightBlue": "#93a3d1",
            "terminal.ansiBrightMagenta": "#b89bbf",
            "terminal.ansiBrightCyan": "#85b7b9",
            "terminal.ansiBrightWhite": "#e8e8e2"
        }
    }
}
