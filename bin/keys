#!/bin/sh
# keys — cheat sheet for the paper tmux / alacritty bindings. Inside tmux: F1.
b=$(printf '\033[1m'); d=$(printf '\033[90m'); bl=$(printf '\033[34m'); r=$(printf '\033[0m')

cat <<EOF

${b}вкладки${r}                                  ${d}всё на Alt, без префикса · в русской раскладке те же клавиши${r}
  ${bl}Alt+T${r}         новая вкладка             ${bl}Alt+1…9${r}       перейти на вкладку N
  ${bl}Alt+W${r}         закрыть вкладку ${d}(y)${r}       ${bl}Alt+,  Alt+.${r}  предыдущая · следующая
  ${bl}Alt+R${r}         переименовать             ${bl}Alt+<  Alt+>${r}  подвинуть влево · вправо

${b}панели${r}
  ${bl}Alt+\\${r}         разделить: лево | право   ${bl}Alt+H J K L${r}   перейти ← ↓ ↑ →
  ${bl}Alt+-${r}         разделить: верх / низ     ${bl}Alt+Z${r}         на весь экран и обратно
  ${bl}Alt+X${r}         закрыть панель            ${bl}Ctrl+A H J K L${r} размер ${d}(жми повторно)${r}

${b}мышь${r}
  клик по вкладке или панели · колесо — прокрутка · выделение — копирует в буфер Windows
  ${bl}Shift${r}+выделение — мимо tmux · правый клик — вставить ${d}(alacritty)${r}

${b}префикс${r} ${bl}Ctrl+A${r} ${d}(Ctrl+Ф тоже), потом:${r}
  ${bl}[${r}  режим копирования ${d}(v — выделить, y — копировать, q — выйти)${r}
  ${bl}r${r}  перечитать конфиг        ${bl}d${r}  отключиться ${d}(сессия живёт дальше)${r}
  ${bl}|  -${r}  разделить              ${bl}c${r}  новая вкладка             ${bl}?${r}  все привязки tmux

${b}alacritty${r}
  ${bl}Ctrl+V${r} вставить · ${bl}Ctrl+Shift+C${r} копировать · ${bl}Ctrl+Shift+F${r} поиск · ${bl}Ctrl+Shift+N${r} новое окно
  ${bl}Ctrl+= Ctrl+- Ctrl+0${r} размер шрифта · ${bl}Ctrl+Backspace${r} удалить слово

${b}прочее${r}
  ${bl}t help${r} задачи · ${bl}greet${r} сводка · ${bl}keys${r} эта шпаргалка ${d}(в tmux — F1)${r}
EOF
